<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Relay Van Driver Pay Calculator: NG15</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        html, body {
            margin: 0; padding: 0;
            background: #FFFFFF; color: #121212;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        .container { max-width: 720px; margin: 0 auto; padding: 0 16px; }
        p, label, select, input { font-size: 16px; line-height: 1.4; }
        .page-title {
            text-align: center;
            font-size: 32px;
            font-weight: 800;
            margin: 32px 0 20px;
            letter-spacing: -0.3px;
        }
        .calculator {
            background: #FFFFFF;
            border: 1px solid rgba(18,18,18,0.15);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        }
        .form-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
        .form-group-col { flex: 1 1 220px; }
        label { display: block; font-weight: 600; margin-bottom: 8px; }
        select, input[type=range] {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid rgba(18,18,18,0.25);
            border-radius: 8px;
            padding: 12px;
            box-sizing: border-box;
        }
        input[type=range] { padding: 0; height: 36px; cursor: pointer; }
        #results-container {
            margin-top: 12px;
            border-top: 1px solid rgba(18,18,18,0.1);
            padding-top: 20px;
            text-align: center;
        }
        .hero-result .value-chip {
            display: inline-block;
            background: #D6EC83;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 800;
            font-size: 32px;
            margin-top: 8px;
        }
        .other-metrics {
            display: flex; gap: 16px; justify-content: center; 
            margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(18,18,18,0.1);
        }
        .metric .v { font-weight: 700; font-size: 20px; }
        .metric .k { font-size: 14px; color: #666; }
        .compatible-areas { margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(18,18,18,0.1); }
        .area-list { font-weight: 700; color: #121212; font-size: 18px; }
        .hint { font-size: 13px; color: #888; margin-top: 4px; }

        @media (max-width: 600px) {
            .page-title { font-size: 24px; }
            .form-row { flex-direction: column; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="page-title">Relay Van Driver Pay Calculator</h1>
        
        <section class="calculator">
            <div class="form-row">
                <div class="form-group-col">
                    <label for="shiftDuration">1. Shift duration</label>
                    <select id="shiftDuration"></select>
                </div>
                <div class="form-group-col">
                    <label for="vanType">2. Van Type</label>
                    <select id="vanType">
                        <option value="LWB">Long Wheelbase (LWB)</option>
                        <option value="XLWB">Extra Long Wheelbase (XLWB)</option>
                        <option value="Luton">Luton Van</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group-col">
                    <label for="daysWeek">3. Days per week: <span id="daysLabel">5</span></label>
                    <input id="daysWeek" type="range" min="1" max="7" step="1" value="5" />
                    <div class="hint">Slide to adjust your weekly schedule.</div>
                </div>
            </div>

            <div id="results-container"></div>
        </section>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ROUTE_DATA = {
                'NG15': {
                    'Nottingham': {stops:9, miles:58, shift:6},
                    'Sheffield':  {stops:6, miles:97, shift:7},
                    'Birmingham': {stops:7, miles:138, shift:8},
                    'Manchester': {stops:5, miles:155, shift:9},
                    'Liverpool':  {stops:5, miles:224, shift:10}
                }
            };

            const shiftEl = document.getElementById('shiftDuration');
            const vanTypeEl = document.getElementById('vanType');
            const daysEl = document.getElementById('daysWeek');
            const DEPOT_CODE = 'NG15';

            function populateShifts() {
                const durations = [...new Set(Object.values(ROUTE_DATA[DEPOT_CODE]).map(r => r.shift))].sort((a,b) => a-b);
                shiftEl.innerHTML = durations.map(d => `<option value="${d}">${d} hours</option>`).join('');
            }

            function payFor(hours, vanType) {
                const rates = {
                    6:  { LWB: 115, XLWB: 121, Luton: 127 },
                    7:  { LWB: 131, XLWB: 138, Luton: 145 },
                    8:  { LWB: 141, XLWB: 148, Luton: 155 },
                    9:  { LWB: 157, XLWB: 165, Luton: 173 },
                    10: { LWB: 175, XLWB: 185, Luton: 195 }
                };
                return rates[hours] ? rates[hours][vanType] : 0;
            }

            function render() {
                const hours = Number(shiftEl.value);
                const days = Number(daysEl.value);
                const van = vanTypeEl.value;
                document.getElementById('daysLabel').textContent = days;

                const perShift = payFor(hours, van);
                const total = perShift * days;
                
                const areas = Object.entries(ROUTE_DATA[DEPOT_CODE])
                                    .filter(([_, data]) => data.shift === hours)
                                    .map(([name]) => name).join(' or ');

                document.getElementById('results-container').innerHTML = `
                    <div class="hero-result">
                        <div class="label">Estimated Weekly Pay</div>
                        <div class="value-chip">£${total}</div>
                    </div>
                    <div class="other-metrics">
                        <div class="metric"><div class="v">£${perShift}</div><div class="k">Per shift</div></div>
                        <div class="metric"><div class="v">${hours}h</div><div class="k">Length</div></div>
                    </div>
                    <div class="compatible-areas">
                        <div class="label">Routes for this shift:</div>
                        <div class="area-list">${areas}</div>
                    </div>`;
            }

            shiftEl.onchange = render;
            vanTypeEl.onchange = render;
            daysEl.oninput = render;

            populateShifts();
            render();
        });
    </script>
</body>
</html>
